module uart_rx #(
    parameter CLK_FREQ  = 100_000_000,
    parameter BAUD_RATE = 115200
)(
    input  clk, rst,
    input  rx,
    output reg [7:0] data,
    output reg       valid   // 1-cycle pulse when byte is ready
);
    localparam CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;
    localparam HALF         = CLKS_PER_BIT / 2;

    reg [15:0] cnt;
    reg [3:0]  bit_idx;
    reg [7:0]  shift;
    reg [1:0]  state; // 0=IDLE,1=START,2=DATA,3=STOP

    always @(posedge clk or posedge rst) begin
        if (rst) begin
            state <= 0; cnt <= 0; valid <= 0;
        end else begin
            valid <= 0;
            case (state)
                0: if (!rx) begin state<=1; cnt<=HALF; end
                1: if (cnt==0) begin state<=2; cnt<=CLKS_PER_BIT; bit_idx<=0; end
                   else cnt<=cnt-1;
                2: if (cnt==0) begin
                       shift[bit_idx] <= rx;
                       cnt <= CLKS_PER_BIT;
                       if (bit_idx==7) state<=3;
                       else bit_idx<=bit_idx+1;
                   end else cnt<=cnt-1;
                3: if (cnt==0) begin
                       data<=shift; valid<=1; state<=0;
                   end else cnt<=cnt-1;
            endcase
        end
    end
endmodule
