`timescale 1ns / 1ps
module password_validator (
    input  [63:0] password,
    output reg    valid
);

    integer i;
    reg [7:0] ch;

    always @(*) begin
        valid = 1'b1;
        for (i = 0; i < 8; i = i + 1) begin
            ch = password[63 - i*8 -: 8];
            if (!((ch >= 8'd48 && ch <= 8'd57)  ||   // '0'-'9'
                  (ch >= 8'd65 && ch <= 8'd90)  ||   // 'A'-'Z'
                  (ch >= 8'd97 && ch <= 8'd122)))    // 'a'-'z'
                valid = 1'b0;
        end
    end

endmodule


module simple_hash256 (
    input  [63:0]  password,
    output [255:0] hash
);

    wire [63:0] h0;
    wire [63:0] h1;
    wire [63:0] h2;
    wire [63:0] h3;

    assign h0 = password ^ 64'hA5A5A5A5A5A5A5A5;

    assign h1 = {password[50:0], password[63:51]}
                + 64'h123456789ABCDEF0;

    assign h2 = ~(password)
                ^ 64'hFEDCBA9876543210;

    assign h3 = ({password[31:0], password[63:32]})
                + h0
                ^ 64'h0F0F0F0F0F0F0F0F;

    assign hash = {h0, h1, h2, h3};

endmodule


module key_generator (
    input  [255:0] hash,
    output [127:0] aes_key
);

    assign aes_key = hash[255:128];

endmodule


module password_key_derivation (
input  [63:0]  password,output password_valid,output [127:0] aes_key,output [127:0] hash_key);

wire [255:0] hash;
    password_validator validator (
        .password(password),
        .valid   (password_valid));

    

    simple_hash256 hash_generator (
        .password(password),
        .hash    (hash));

    

    key_generator keygen (
        .hash   (hash),
        .aes_key(aes_key));

   
    assign hash_key = hash[127:0];

endmodule


