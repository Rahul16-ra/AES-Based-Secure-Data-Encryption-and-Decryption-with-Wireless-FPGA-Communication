 

module fpga2_aes_dec_top_pipelined_auth #(
    parameter CLK_FREQ  = 100_000_000,
    parameter BAUD_RATE = 115200
)(
    input        clk,
    input        rst,

    input        pmod_rxd,
    output       pmod_txd,

    input        UART_rxd,
    output       UART_txd,

    output [2:0] led
);

    localparam [23:0] SYNC_SEQ = 24'hABCDEF;

  
    wire [7:0] pmod_rx_data; wire pmod_rx_valid;
    uart_rx #(.CLK_FREQ(CLK_FREQ),.BAUD_RATE(BAUD_RATE)) U_PMOD_RX (
        .clk(clk),.rst(rst),.rx(pmod_rxd),
        .data(pmod_rx_data),.valid(pmod_rx_valid));

    reg [7:0] pmod_tx_data=0; reg pmod_tx_start=0; wire pmod_tx_busy;
    uart_tx #(.CLK_FREQ(CLK_FREQ),.BAUD_RATE(BAUD_RATE)) U_PMOD_TX (
        .clk(clk),.rst(rst),.data(pmod_tx_data),.start(pmod_tx_start),
        .tx(pmod_txd),.busy(pmod_tx_busy));

    wire [7:0] usb_rx_data; wire usb_rx_valid;
    uart_rx #(.CLK_FREQ(CLK_FREQ),.BAUD_RATE(BAUD_RATE)) U_USB_RX (
        .clk(clk),.rst(rst),.rx(UART_rxd),
        .data(usb_rx_data),.valid(usb_rx_valid));

    reg [7:0] usb_tx_data=0; reg usb_tx_start=0; wire usb_tx_busy;
    uart_tx #(.CLK_FREQ(CLK_FREQ),.BAUD_RATE(BAUD_RATE)) U_USB_TX (
        .clk(clk),.rst(rst),.data(usb_tx_data),.start(usb_tx_start),
        .tx(UART_txd),.busy(usb_tx_busy));

    
    reg  [63:0]  password_reg = 64'd0;
    wire         password_valid;
    wire [127:0] aes_key, hash_key;

    password_key_derivation U_KDF (
        .password(password_reg),.password_valid(password_valid),
        .aes_key(aes_key),.hash_key(hash_key));

   
    reg  [127:0] aes_ciphertext = 0;
    wire [127:0] plaintext_out;
    reg          aes_start = 0;
    wire         aes_done;

    aes_dec_top AES_DEC (
        .clk(clk),.rst(rst),.start(aes_start),
        .ciphertext(aes_ciphertext),.key(aes_key),
        .plaintext(plaintext_out),.done(aes_done));

   
    reg [127:0] ping = 0, pong = 0;
    reg         buf_full_0 = 0, buf_full_1 = 0;
    reg         rx_buf_sel = 0;

   
    reg [1:0] sync_state   = 0;
    reg       sync_ok      = 0;
    reg       sync_ok_prev = 0;

    always @(posedge clk or posedge rst) begin
        if (rst) begin sync_state <= 0; sync_ok <= 0; end
        else if (!sync_ok && pmod_rx_valid) begin
            case (sync_state)
                2'd0: sync_state <= (pmod_rx_data == SYNC_SEQ[23:16]) ? 2'd1 : 2'd0;
                2'd1: sync_state <= (pmod_rx_data == SYNC_SEQ[15:8])  ? 2'd2 : 2'd0;
                2'd2: begin
                    if (pmod_rx_data == SYNC_SEQ[7:0]) begin
                        sync_ok <= 1; sync_state <= 2'd3;
                    end else sync_state <= 2'd0;
                end
                default:;
            endcase
        end
    end

   
    localparam S_WAIT_PW   = 3'd0;
    localparam S_CHECK_PW  = 3'd1;
    localparam S_RECV_SYNC = 3'd2;
    localparam S_RECV_VK   = 3'd3;
    localparam S_VERIFY    = 3'd4;
    localparam S_STREAM    = 3'd5;

    localparam P_IDLE = 2'd0;
    localparam P_AES  = 2'd1;
    localparam P_TX   = 2'd2;

    reg [2:0]   state         = S_WAIT_PW;
    reg [1:0]   pipe_state    = P_IDLE;
    reg [3:0]   auth_cnt      = 4'd0;
    reg [3:0]   rx_byte_cnt   = 4'd0;
    reg [127:0] received_vkey = 128'd0;
    reg         reject_pulse  = 1'b0;

    // Pipeline TX
    reg [127:0] tx_shift = 0;
    reg [3:0]   tx_cnt   = 0;

    
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            state          <= S_WAIT_PW;
            pipe_state     <= P_IDLE;
            auth_cnt       <= 0;
            rx_byte_cnt    <= 0;
            password_reg   <= 0;
            received_vkey  <= 0;
            reject_pulse   <= 0;
            sync_ok_prev   <= 0;
            ping           <= 0;  pong       <= 0;
            buf_full_0     <= 0;  buf_full_1 <= 0;
            rx_buf_sel     <= 0;
            aes_start      <= 0;  aes_ciphertext <= 0;
            tx_shift       <= 0;  tx_cnt     <= 0;
            pmod_tx_data   <= 0;  pmod_tx_start  <= 0;
            usb_tx_data    <= 0;  usb_tx_start   <= 0;
        end else begin
            pmod_tx_start <= 0;
            usb_tx_start  <= 0;
            reject_pulse  <= 0;
            aes_start     <= 0;
            sync_ok_prev  <= sync_ok;

            case (state)

            
            S_WAIT_PW: begin
                if (usb_rx_valid) begin
                    password_reg <= {password_reg[55:0], usb_rx_data};
                    if (auth_cnt == 4'd7) begin
                        auth_cnt <= 0; state <= S_CHECK_PW;
                    end else auth_cnt <= auth_cnt + 1;
                end
            end

          
            S_CHECK_PW: begin
                if (password_valid) begin
                    auth_cnt <= 0; state <= S_RECV_SYNC;
                end else begin
                    auth_cnt <= 0; reject_pulse <= 1; state <= S_WAIT_PW;
                end
            end

         
            S_RECV_SYNC: begin
                // Wait for the rising edge of sync_ok (preamble detected)
                if (sync_ok && !sync_ok_prev) begin
                    auth_cnt <= 0; state <= S_RECV_VK;
                end
            end

        
            S_RECV_VK: begin
                if (pmod_rx_valid) begin
                    received_vkey <= {received_vkey[119:0], pmod_rx_data};
                    if (auth_cnt == 4'd15) begin
                        auth_cnt <= 0; state <= S_VERIFY;
                    end else auth_cnt <= auth_cnt + 1;
                end
            end

        
            S_VERIFY: begin
                if (!pmod_tx_busy && !pmod_tx_start) begin
                    if (received_vkey == hash_key) begin
                        pmod_tx_data  <= 8'hAA;
                        pmod_tx_start <= 1;
                        // Clear ping-pong before streaming
                        rx_buf_sel    <= 0;  rx_byte_cnt <= 0;
                        buf_full_0    <= 0;  buf_full_1  <= 0;
                        pipe_state    <= P_IDLE;
                        state         <= S_STREAM;
                    end else begin
                        pmod_tx_data  <= 8'h55;
                        pmod_tx_start <= 1;
                        reject_pulse  <= 1;
                        auth_cnt      <= 0;
                        state         <= S_WAIT_PW;
                    end
                end
            end

          
            S_STREAM: begin

                
                if (pmod_rx_valid) begin
                    if (rx_buf_sel == 0)
                        ping <= {ping[119:0], pmod_rx_data};
                    else
                        pong <= {pong[119:0], pmod_rx_data};

                    if (rx_byte_cnt == 4'd15) begin
                        rx_byte_cnt <= 0;
                        if (rx_buf_sel == 0) buf_full_0 <= 1;
                        else                 buf_full_1 <= 1;

                        if (rx_buf_sel == 0 && !buf_full_1)      rx_buf_sel <= 1;
                        else if (rx_buf_sel == 1 && !buf_full_0) rx_buf_sel <= 0;
                    end else begin
                        rx_byte_cnt <= rx_byte_cnt + 1;
                    end
                end

               
                case (pipe_state)

                P_IDLE: begin
                    if (buf_full_0) begin
                        aes_ciphertext <= ping;
                        aes_start      <= 1;
                        buf_full_0     <= 0;   // claim - single driver
                        pipe_state     <= P_AES;
                    end else if (buf_full_1) begin
                        aes_ciphertext <= pong;
                        aes_start      <= 1;
                        buf_full_1     <= 0;   // claim - single driver
                        pipe_state     <= P_AES;
                    end
                end

                P_AES: begin
                    if (aes_done) begin
                        tx_shift   <= plaintext_out;
                        tx_cnt     <= 0;
                        pipe_state <= P_TX;
                    end
                end

                P_TX: begin
                    if (!usb_tx_busy && !usb_tx_start) begin
                        usb_tx_data  <= tx_shift[127:120];
                        tx_shift     <= {tx_shift[119:0], 8'h00};
                        usb_tx_start <= 1;
                        if (tx_cnt == 4'd15) pipe_state <= P_IDLE;
                        else                 tx_cnt <= tx_cnt + 1;
                    end
                end

                default: pipe_state <= P_IDLE;
                endcase
            end // S_STREAM

            default: state <= S_WAIT_PW;
            endcase
        end
    end

   
    reg [21:0] rx_stretch = 0, reject_stretch = 0;

    always @(posedge clk) begin
        if (rst)                rx_stretch <= 0;
        else if (pmod_rx_valid) rx_stretch <= 22'h3FFFFF;
        else if (|rx_stretch)   rx_stretch <= rx_stretch - 1;
    end

    always @(posedge clk) begin
        if (rst)               reject_stretch <= 0;
        else if (reject_pulse) reject_stretch <= 22'h3FFFFF;
        else if (|reject_stretch) reject_stretch <= reject_stretch - 1;
    end

    assign led[0] = |rx_stretch;
    assign led[1] = (state == S_STREAM) ? (pipe_state == P_AES) : |reject_stretch;
    assign led[2] = usb_tx_busy;

endmodule
