module uart_tx #(
    parameter CLK_FREQ  = 100_000_000,
    parameter BAUD_RATE = 115200
)(
    input  clk, rst,
    input  [7:0] data,
    input        start,
    output reg   tx,
    output reg   busy
);
    localparam CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;
    reg [15:0] cnt;
    reg [3:0]  bit_idx;
    reg [9:0]  shift; // start + 8 data + stop
    reg        active;

    always @(posedge clk or posedge rst) begin
        if (rst) begin tx<=1; busy<=0; active<=0; end
        else begin
            if (!active && start) begin
                shift  <= {1'b1, data, 1'b0}; // stop,data[7:0],start
                cnt    <= CLKS_PER_BIT;
                bit_idx<= 0; active<=1; busy<=1;
            end else if (active) begin
                if (cnt == 0) begin
                    tx      <= shift[0];
                    shift   <= {1'b1, shift[9:1]};
                    cnt     <= CLKS_PER_BIT;
                    if (bit_idx == 9) begin active<=0; busy<=0; end
                    else bit_idx <= bit_idx+1;
                end else cnt <= cnt-1;
            end
        end
    end
endmodule
